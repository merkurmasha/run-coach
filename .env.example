# Copy to .env (the setup wizard does this for you and chmods it 600).
# Never commit the real .env.

# Required: from https://connect.garmin.com/app/settings/personalApiToken
GARMIN_API_KEY=

# Optional: enables the recommendations panel and the weekly report's prose.
# Without it, the dashboard still works on computed numbers alone.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: enables `report --send-telegram`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
